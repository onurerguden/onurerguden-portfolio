# Keep preview deployments non-indexable; enable only after release review.
SITE_INDEXABLE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Add an updated, publication-ready PDF to public before setting this.
NEXT_PUBLIC_CV_URL=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# The Vercel Marketplace Upstash integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
# Optional: pinged only after a fully successful daily reconciliation.
CRON_HEARTBEAT_URL=
# Search Console and Bing Webmaster Tools ownership tags, production only.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
