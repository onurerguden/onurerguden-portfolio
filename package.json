{
  "name": "onurerguden-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests scripts *.ts *.mts",
    "check:links": "tsx scripts/check-external-links.ts",
    "desk:package": "node scripts/desk/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@upstash/redis": "1.38.4",
    "@vercel/speed-insights": "2.0.0",
    "gray-matter": "4.0.3",
    "motion": "13.2.0",
    "next": "16.3.4",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
